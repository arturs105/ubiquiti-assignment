--minversion 0.63.1
--swiftversion 6.2
--indent 4
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--stripunusedargs closure-only
--self remove
--importgrouping testable-bottom
--extensionacl on-declarations
--header strip
--enable isEmpty, wrapEnumCases, blankLinesBetweenImports
--disable andOperator, wrapPropertyBodies, swiftTestingTestCaseNames
